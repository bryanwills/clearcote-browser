+// clearcote: case-insensitive membership test against a canonical font list (CSS font
+// family names are case-insensitive).
+static bool FontInListCaseInsensitive(const std::vector<std::string>& list,
+                                      const std::string& family) {
+  for (const std::string& f : list) {
+    if (base::EqualsCaseInsensitiveASCII(f, family))
+      return true;
+  }
+  return false;
+}
