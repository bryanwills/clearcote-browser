+COMPONENT_EXPORT(UNGOOGLED) extern const char kDisableFingerprintNoise[];
+COMPONENT_EXPORT(UNGOOGLED) extern const char kDisableGpuStringSpoof[];
+COMPONENT_EXPORT(UNGOOGLED) extern const char kDisableCanvasNoise[];
+COMPONENT_EXPORT(UNGOOGLED) extern const char kFingerprintProfile[];
