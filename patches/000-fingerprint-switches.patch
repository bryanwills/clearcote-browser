+++ b/components/ungoogled/ungoogled_switches.cc	2026-07-21 09:13:09.553740702 +0000
@@ -15,4 +15,90 @@
 // Enable fingerprinting deception for Canvas image data
 const char kFingerprintingCanvasImageDataNoise[] = "fingerprinting-canvas-image-data-noise";
 
+// Specify the fingerprint seed
+const char kFingerprint[] = "fingerprint";
+
+// Specify the browser brand
+const char kFingerprintBrand[] = "fingerprint-brand";
+
+// Specify the browser version
+const char kFingerprintBrandVersion[] = "fingerprint-brand-version";
+
+// Specify the GPU VENDOR
+const char kFingerprintGpuVendor[] = "fingerprint-gpu-vendor";
+
+// Specify the GPU RENDERER
+const char kFingerprintGpuRenderer[] = "fingerprint-gpu-renderer";
+
+// Specify the number of CPU cores
+const char kFingerprintHardwareConcurrency[] = "fingerprint-hardware-concurrency";
+// clearcote-light-stealth: read FIRST in each Blink getter (flag > persona > real).
+//
+// kFingerprintDeviceMemory is the one exception to "in each Blink getter":
+// it is applied ONCE, in the blink/common ApproximatedDeviceMemory helper,
+// because the Device-Memory client-hint header is emitted in the BROWSER
+// process and a renderer-only override cannot reach it. navigator.deviceMemory
+// and that header therefore derive from the same number, with the Chrome
+// power-of-two bucketing and kMinMemory/kMaxMemory clamp preserved. Same
+// switch name and same flag > persona > real precedence, so the light_stealth
+// preset shipped in SDK 0.18.0 is unaffected.
+const char kFingerprintDeviceMemory[] = "fingerprint-device-memory";
+const char kFingerprintScreenWidth[] = "fingerprint-screen-width";
+const char kFingerprintScreenHeight[] = "fingerprint-screen-height";
+const char kFingerprintAvailWidth[] = "fingerprint-avail-width";
+const char kFingerprintAvailHeight[] = "fingerprint-avail-height";
+const char kFingerprintColorDepth[] = "fingerprint-color-depth";
+const char kFingerprintDevicePixelRatio[] = "fingerprint-device-pixel-ratio";
+const char kFingerprintMaxTouchPoints[] = "fingerprint-max-touch-points";
+
+// Specify the operating system type
+const char kFingerprintPlatform[] = "fingerprint-platform";
+
+// Specify the operating system version
+const char kFingerprintPlatformVersion[] = "fingerprint-platform-version";
+
+// Specify the location
+const char kFingerprintLocation[] = "fingerprint-location";
+
+// Specify the timezone
+const char kFingerprintTimezone[] = "timezone";
+
+// Disable GPU fingerprint spoofing
+const char kDisableGpuFingerprint[] = "disable-gpu-fingerprint";
+const char kDisableFingerprintNoise[] = "disable-fingerprint-noise";
+
+// clearcote: the two independent halves of the bundles above. Each is a strict SUBSET of an
+// existing switch, so with neither passed every gate below evaluates exactly as before.
+//
+// --disable-gpu-string-spoof reports the REAL WebGL UNMASKED_VENDOR/RENDERER and nothing
+// else: the getParameter limit table, the supported-extension list,
+// getShaderPrecisionFormat and the readPixels farble all stay on the persona, unlike
+// --disable-gpu-fingerprint which reverts every one of them to the real backend.
+const char kDisableGpuStringSpoof[] = "disable-gpu-string-spoof";
+
+// --disable-canvas-noise turns off the per-eTLD+1 farble on CANVAS 2D readback only
+// (getImageData, and toDataURL of a 2D context). WebGL readPixels, the snapshot of a
+// WebGL canvas, and every other farbled surface keep their current behaviour, unlike
+// --disable-fingerprint-noise which is the process-wide off switch for all of them.
+const char kDisableCanvasNoise[] = "disable-canvas-noise";
+const char kFingerprintProfile[] = "fingerprint-profile";
+
+// Specify the TLS network persona (e.g. "chrome-149", "chrome-120"); absent /
+// "off" / "native" leaves the stock ClientHello unchanged. Read in the network
+// service process.
+const char kFingerprintTlsProfile[] = "fingerprint-tls-profile";
+
+// Canvas bridge: forward canvas/WebGL ops to a remote real-GPU render host
+// ("ws://host:port/path"). When unset, rendering stays fully local.
+const char kCanvasBridgeUrl[] = "canvas-bridge-url";
+// Canvas bridge HTTP Basic credentials, "user:secret".
+const char kCanvasBridgeAuth[] = "canvas-bridge-auth";
+// Per-origin policy: off | all (default) | allow | deny.
+const char kCanvasBridgeMode[] = "canvas-bridge-mode";
+// Comma-separated eTLD+1 list for mode=allow / mode=deny.
+const char kCanvasBridgeAllow[] = "canvas-bridge-allow";
+const char kCanvasBridgeDeny[] = "canvas-bridge-deny";
+// Cold cache-miss behavior: block (default) | local (never stall; render local).
+const char kCanvasBridgeFallback[] = "canvas-bridge-fallback";
+
 }  // namespace switches
