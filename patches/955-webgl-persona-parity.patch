+// clearcote (r11): the persona extension list for THIS context version, or nullptr when
+// the real set should be used. A profile that lists extensions this build does not implement
+// used to be replayed verbatim, so getSupportedExtensions() advertised names that
+// getExtension() then returned null for -- enumerate-then-get is a one-line detector and no
+// real browser produces a null there. The list is now intersected with what is actually
+// served, and getExtension() refuses anything the list does not advertise, so the advertised
+// set and the gettable set are the same set in both directions.
+static const std::vector<std::string>* CcPersonaExtList(bool is_webgl2) {
+  const auto& p = ungoogled::CurrentPersona();
+  if (p.webgl_real)
+    return nullptr;
+  const std::vector<std::string>& v =
+      is_webgl2 ? p.webgl2_extensions : p.webgl_extensions;
+  return v.empty() ? nullptr : &v;
+}
+
+// Whether the persona advertises `name`. True when no persona list is active, so the stock
+// behaviour is untouched.
+static bool CcPersonaAdvertises(bool is_webgl2, const String& name) {
+  const std::vector<std::string>* v = CcPersonaExtList(is_webgl2);
+  if (!v)
+    return true;
+  // WEBGL_debug_renderer_info is exempt, always. It carries no GPU capability -- it only
+  // exposes the UNMASKED vendor/renderer STRINGS, which is the very channel the persona GPU is
+  // read through. A profile that happens to omit it (hand-written, or captured by a collector
+  // that did not enumerate it) would otherwise make the spoofed GPU unreadable AND leave the
+  // context without an extension every real Chrome exposes -- strictly worse than serving it.
+  if (name == WebGLDebugRendererInfo::ExtensionName())
+    return true;
+  for (const std::string& e : *v) {
+    if (name == String::FromUtf8(e))
+      return true;
+  }
+  return false;
+}
